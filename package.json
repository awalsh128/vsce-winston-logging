{
  "name": "winston-host-adapters-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Winston logging adapters for VS Code, GitHub Actions and other hosts.",
  "license": "Apache-2.0",
  "author": "awalsh128",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awalsh128/winston-host-adapters.git"
  },
  "workspaces": [
    "packages/winston-host",
    "packages/winston-vscode",
    "packages/winston-github-actions"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "check": "npm run build && npm run typecheck && npm test",
    "docs:api": "npm run docs:api --workspaces --if-present && node scripts/docs-index.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.11",
    "@types/triple-beam": "^1.3.5",
    "@types/vscode": "~1.74.0",
    "chai": "^6.2.2",
    "husky": "^9.1.7",
    "lint-staged": "~17.6.0",
    "mocha": "^12.0.3",
    "prettier": "~3.9.10",
    "prettier-plugin-padding-lines": "^0.1.0",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "glob": ">=14.0.3",
    "minimatch": ">=11.0.2"
  }
}
