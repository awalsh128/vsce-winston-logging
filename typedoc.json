{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "outputs": [{ "name": "html", "path": "./docs/api" }],
  "tsconfig": "tsconfig.build.json",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "includeVersion": true,
  "sort": ["source-order"],
  "readme": "none",
  "gitRevision": "{branch}"
}
